# Host and TLS
DOMAIN=replicahomesaloonservice.in
TLS_EMAIL=admin@replicahomesaloonservice.in

# Runtime
NODE_ENV=production
APP_ENV=production
PORT=4000
WEB_ORIGIN=https://replicahomesaloonservice.in
API_ORIGIN=https://replicahomesaloonservice.in
NEXT_PUBLIC_API_BASE_URL=/api/v1
REQUEST_ID_HEADER=x-request-id
BUSINESS_TIMEZONE=Asia/Kolkata

# MySQL container credentials. Use URL-safe values such as openssl rand -hex 32.
MYSQL_DATABASE=replica_home_salon
MYSQL_USER=replica
MYSQL_PASSWORD=replace_with_hex_password
MYSQL_ROOT_PASSWORD=replace_with_hex_root_password

# Auth
BETTER_AUTH_SECRET=replace_with_at_least_32_chars
BETTER_AUTH_URL=https://replicahomesaloonservice.in
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_BOOTSTRAP_PASSWORD=replace_for_first_seed_then_remove

# Razorpay. Keep these server-side values out of git.
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Optional providers
SMS_PROVIDER_API_KEY=
EMAIL_SMTP_URL=
WHATSAPP_PROVIDER_TOKEN=
MAPS_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
